// Cloudflare settings: the built site in public/, with worker.js in front of every page
{
  "name": "personal-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Pages run the Worker, for the saved theme, while fonts, the resume, and other files skip it
    "run_worker_first": ["/*", "!/*.woff2", "!/*.css", "!/*.pdf", "!/*.png", "!/*.svg", "!/*.ico", "!/*.txt", "!/*.xml"],
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "cameronwright.dev", "custom_domain": true },
    { "pattern": "www.cameronwright.dev", "custom_domain": true }
  ]
}
